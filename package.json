    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "adhan": "^4.4.3",
    "astro": "^7.3.2",
    "date-fns": "^3.6.0",
    "picnic": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^4.130.0"
